{
  "name": "marvel-champions-tabletop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:production-entry": "node scripts/production-entry-check.mjs",
    "sync:cards": "node scripts/sync-cards.mjs",
    "test:ui": "node scripts/browser-check.mjs",
    "test:accounts": "node scripts/accounts-check.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"src/*.css\" \"tests/**/*.ts\" \"scripts/*.mjs\" vite.config.ts",
    "test:design": "node scripts/design-check.mjs",
    "test:tabletop": "node scripts/tabletop-check.mjs",
    "test:viewport-fit": "node scripts/viewport-fit-check.mjs",
    "test:flow": "node scripts/flow-check.mjs",
    "test:onboarding": "node scripts/onboarding-check.mjs",
    "test:catalog": "node scripts/catalog-check.mjs",
    "test:expansion": "node scripts/expansion-check.mjs",
    "test:engine-continuation": "node scripts/engine-continuation-check.mjs",
    "audit:engine": "node scripts/audit-engine-expansion.mjs",
    "test:hero-packs": "node scripts/hero-pack-check.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
